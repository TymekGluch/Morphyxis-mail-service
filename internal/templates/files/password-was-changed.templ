package templatesFiles

import (
  "Morphyxis-mail-service/internal/templates"
)

templ PasswordWasChanged(input templates.PasswordWasChangedInput) {
  <div style="background: #f8fbff; width: 100%; padding: 36px; margin: 0;">
    <table cellpadding="0" cellspacing="0" border="0" style="background: #ffffff; width: 100%; max-width: 600px; margin: 40px auto; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
      <tr>
        <td style="padding: 36px; text-align: left;">
          <h2 style="margin: 0 0 12px 0; color: #2563eb; font-size: 24px; font-weight: 700; letter-spacing: 0.5px;">Password Changed Successfully</h2>
          <p style="margin: 0 0 18px 0; color: #333333; font-size: 16px;">Hello, {input.Name},</p>
          <p style="margin: 0 0 18px 0; color: #333333; font-size: 15px;">We would like to inform you that your account password has been successfully changed.</p>
          <p style="margin: 0 0 18px 0; color: #333333; font-size: 15px;">Date of change: <b>{input.DateOfRequestFormatted()}</b></p>
          <p style="margin: 0 0 18px 0; color: #333333; font-size: 15px;">If you did not perform this action, please contact our support team immediately to secure your account.</p>
          <p style="margin: 0 0 0 0; color: #757575; font-size: 13px;">If you have any questions or need assistance, feel free to contact us.</p>
        </td>
      </tr>
    </table>
  </div>
}
