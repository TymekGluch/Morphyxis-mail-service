package templatesFiles

import (
  "Morphyxis-mail-service/internal/templates"
)

templ AccountConfirmation(input templates.AccountConfirmationInput) {
  <div style="background: #f8fbff; width: 100%; padding: 36px; margin: 0;">
    <table cellpadding="0" cellspacing="0" border="0" style="background: #ffffff; width: 100%; max-width: 600px; margin: 40px auto; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
      <tr>
        <td style="padding: 36px; text-align: left;">
          <h2 style="margin: 0 0 12px 0; color: #1a237e; font-size: 24px; font-weight: 700; letter-spacing: 0.5px;">Witaj, {input.Name}!</h2>
            <p style="margin: 0 0 18px 0; color: #333333; font-size: 16px;">Thank you for registering with our service.<br>To activate your account, please confirm your email address by entering the verification code below:</p>
          <div style="margin: 24px 0; text-align: center;">
            <span style="display: inline-block; background: #f1f8e9; color: #388e3c; font-size: 28px; font-weight: bold; letter-spacing: 4px; padding: 16px 32px; border-radius: 6px; border: 1px solid #c8e6c9;">{input.VerificationCode}</span>
          </div>
            <p style="margin: 0 0 18px 0; color: #333333; font-size: 15px;">This code is valid for a limited time. If you do not verify your account by <b>{input.AccountDeletionDateFormatted()}</b>, your account will be automatically deleted.</p>
            <p style="margin: 0 0 0 0; color: #757575; font-size: 13px;">If you did not register for our service, please ignore this message.</p>
        </td>
      </tr>
    </table>
  </div>
}
