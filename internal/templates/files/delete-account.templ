package templatesFiles

import (
  "Morphyxis-mail-service/internal/templates"
)

templ DeletedAccount(input templates.DeletedAccountInput) {
  <div style="background: #f8fbff; width: 100%; padding: 36px; margin: 0;">
    <table cellpadding="0" cellspacing="0" border="0" style="background: #ffffff; width: 100%; max-width: 600px; margin: 40px auto; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
      <tr>
        <td style="padding: 36px; text-align: left;">
          <h2 style="margin: 0 0 12px 0; color: #b71c1c; font-size: 24px; font-weight: 700; letter-spacing: 0.5px;">Account Deleted</h2>
          <p style="margin: 0 0 18px 0; color: #333333; font-size: 16px;">Hello, <strong>{input.Name}</strong>,</p>
          <p style="margin: 0 0 18px 0; color: #333333; font-size: 15px;">We would like to inform you that your account has been permanently deleted from our service.</p>
          <p style="margin: 0 0 18px 0; color: #333333; font-size: 15px;">Reason for deletion: <b>{input.Reason}</b></p>
          <p style="margin: 0 0 18px 0; color: #333333; font-size: 15px;">All data associated with your account has also been permanently deleted from our systems.</p>
          <p style="margin: 0 0 0 0; color: #757575; font-size: 13px;">If you have any questions or believe this was a mistake, please contact our support team.</p>
        </td>
      </tr>
    </table>
  </div>
}
